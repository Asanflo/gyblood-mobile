<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 8 (LTS). Pour rester en .NET 8 : net8.0-android et adapter le workload MAUI. -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>GyBlood.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>GyBlood</ApplicationTitle>
    <ApplicationId>com.gyblood.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <!-- APK installable directement (démonstration). Pour le Play Store, passer en aab. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Force l'inclusion de toutes les DLLs .NET directement dans l'APK -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidFastDeployment>false</AndroidFastDeployment>

    <!-- Force le générateur de code Refit -->
    <RefitInternalNamespace>GyBlood.Mobile.Refit</RefitInternalNamespace>
    
    <!-- S'assure que le générateur de code source Refit est bien actif -->
    <RefitInternalNamespace>GyBlood.Mobile.Refit</RefitInternalNamespace>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#B71C1C" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#B71C1C" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*.svg;Resources\Images\*.png;Resources\Images\*.jpg" />
    <MauiFont Include="Resources\Fonts\*.ttf;Resources\Fonts\*.otf" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\.gitkeep" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Versions flottantes : lancez un premier restore puis figez les versions obtenues. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
    <PackageReference Include="Refit" Version="7.2.22" />
    <PackageReference Include="Refit.HttpClientFactory" Version="7.2.22" />  
    <PackageReference Include="Mapsui.Maui" Version="4.1.8" />
    <PackageReference Include="Mapsui.Tiling" Version="4.1.8" />
  </ItemGroup>

</Project>
