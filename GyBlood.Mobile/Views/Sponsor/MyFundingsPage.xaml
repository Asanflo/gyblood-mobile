<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Sponsor"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Sponsor.MyFundingsPage"
             x:DataType="vm:MyFundingsViewModel"
             Title="Mes financements"
             Shell.NavBarIsVisible="True">
  <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
    <CollectionView ItemsSource="{Binding Items}">
      <CollectionView.Header>
        <VerticalStackLayout Padding="20,12,20,8" Spacing="6">
          <Label Text="{Binding TotalText}" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                 IsVisible="{Binding TotalText, Converter={StaticResource StringNotEmpty}}" />
          <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                 IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
        </VerticalStackLayout>
      </CollectionView.Header>
      <CollectionView.ItemsLayout>
        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
      </CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="items:FundingItem">
          <controls:FundingCard Margin="20,0" />
        </DataTemplate>
      </CollectionView.ItemTemplate>
      <CollectionView.EmptyView>
        <controls:EmptyState Message="Vous n'avez encore financé aucune campagne." />
      </CollectionView.EmptyView>
      <CollectionView.Footer>
        <BoxView HeightRequest="16" Color="Transparent" />
      </CollectionView.Footer>
    </CollectionView>
  </RefreshView>
</ContentPage>
