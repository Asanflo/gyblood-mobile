<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Sponsor"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Sponsor.SponsorProfilePage"
             x:DataType="vm:SponsorProfileViewModel"
             Title="Profil"
             Shell.NavBarIsVisible="True">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <!-- IMAGE : logo de l'organisation -->
      <controls:ImageFrame WidthRequest="88" HeightRequest="88" Caption="Logo" CornerRadius="44" HorizontalOptions="Center" />

      <controls:FormField Header="Adresse email" Text="{Binding Email}" IsReadOnly="True" />
      <controls:FormField Header="Organisation" IsRequired="True" Placeholder="Nom de l'entreprise ou de l'ONG" Text="{Binding Organisation}" />
      <controls:FormField Header="Contact" IsRequired="True" Placeholder="Nom et téléphone du contact" Text="{Binding Contact}" />

      <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      <Button Text="Enregistrer" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
      <Button Text="Se déconnecter" Command="{Binding LogoutCommand}" Style="{StaticResource LinkButton}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
