<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.FundingCard"
             x:DataType="items:FundingItem">
  <Border Style="{StaticResource Card}">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3" ColumnSpacing="8">
      <Label Grid.Row="0" Text="{Binding CampaignTitle}" FontAttributes="Bold" />
      <controls:StatusChip Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" ChipColor="{Binding StatusColor}" />
      <Label Grid.Row="1" Text="{Binding DateText}" Style="{StaticResource Caption}" />
      <Label Grid.Row="1" Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
    </Grid>
  </Border>
</ContentView>
