<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.FundingCard"
             x:DataType="items:FundingItem">
  <Border Style="{StaticResource Card}">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Border WidthRequest="44" HeightRequest="44" VerticalOptions="Start"
              BackgroundColor="{StaticResource WarningLight}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
        <Image Source="camp_coins" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
      </Border>

      <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
        <Label Text="{Binding CampaignTitle}" FontAttributes="Bold" FontSize="15" MaxLines="2" LineBreakMode="TailTruncation" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <Image Source="camp_calendar" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
          <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
        </Grid>
      </VerticalStackLayout>

      <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
        <Label Text="{Binding AmountText}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="End" />
        <controls:StatusChip Text="{Binding StatusText}" ChipColor="{Binding StatusColor}" HorizontalOptions="End" />
      </VerticalStackLayout>
    </Grid>
  </Border>
</ContentView>