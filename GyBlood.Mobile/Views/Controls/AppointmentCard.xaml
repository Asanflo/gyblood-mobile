<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.AppointmentCard"
             x:DataType="items:AppointmentItem">
  <Border Style="{StaticResource Card}">
    <Border.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding OpenCommand}" />
    </Border.GestureRecognizers>
    <VerticalStackLayout Spacing="10">

      <!-- En-tête : pastille, titre, statut -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border WidthRequest="44" HeightRequest="44" VerticalOptions="Start"
                BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
          <Image Source="camp_calendar" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
          <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" MaxLines="1" />
          <Label Text="{Binding Subtitle}" Style="{StaticResource Subtitle}" LineBreakMode="TailTruncation" MaxLines="1" />
        </VerticalStackLayout>
        <controls:StatusChip Grid.Column="2" Text="{Binding StatusText}" ChipColor="{Binding StatusColor}" VerticalOptions="Start" />
      </Grid>

      <BoxView HeightRequest="1" Color="{StaticResource Stroke}" />

      <!-- Date et frais -->
      <FlexLayout Wrap="Wrap" AlignItems="Center">
        <HorizontalStackLayout Spacing="6" Margin="0,0,14,4">
          <Image Source="card_clock" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
          <Label Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Border BackgroundColor="{StaticResource WarningLight}" StrokeThickness="0" Padding="10,5"
                StrokeShape="RoundRectangle 14" Margin="0,0,0,4" IsVisible="{Binding HasFee}">
          <HorizontalStackLayout Spacing="6">
            <Image Source="camp_coins" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
            <Label Text="{Binding FeeText}" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Warning}" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Border>
      </FlexLayout>

      <!-- Actions -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasActions}">
        <Button Grid.Column="0" Text="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsVisible="{Binding HasPrimary}" Style="{StaticResource SmallButton}" />
        <Button Grid.Column="1" Text="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" IsVisible="{Binding HasSecondary}" Style="{StaticResource SmallOutlineButton}" />
      </Grid>
    </VerticalStackLayout>
  </Border>
</ContentView>