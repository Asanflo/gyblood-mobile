<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.StockCard"
             x:DataType="items:StockItem">
  <Border Style="{StaticResource Card}">
    <VerticalStackLayout Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" VerticalOptions="Start"
                BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 24">
          <Label Text="{Binding BloodText}" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Image Source="camp_hospital" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding StructureName}" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasDistance}">
            <Image Source="camp_pin" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding DistanceText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Image Source="card_clock" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
          </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
          <Label Text="{Binding QuantityText}" FontAttributes="Bold" FontSize="17" HorizontalOptions="End" />
          <Border BackgroundColor="{Binding LevelBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                  Padding="8,2" HorizontalOptions="End">
            <Label Text="{Binding LevelText}" TextColor="{Binding LevelColor}" FontSize="11" FontAttributes="Bold" />
          </Border>
        </VerticalStackLayout>
      </Grid>

      <BoxView HeightRequest="1" Color="{StaticResource Stroke}" />
      <Button Text="Contacter le centre" Command="{Binding ContactCommand}" Style="{StaticResource SmallOutlineButton}" />
    </VerticalStackLayout>
  </Border>
</ContentView>