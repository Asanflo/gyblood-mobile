<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.DonorCard"
             x:DataType="items:DonorItem">
  <!-- Carte compacte du carrousel affiché sous la carte. -->
  <Border Style="{StaticResource Card}" WidthRequest="290">
    <VerticalStackLayout Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource PrimaryLight}"
                StrokeThickness="0" StrokeShape="RoundRectangle 24">
          <Label Text="{Binding BloodText}" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
          <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" />
          <HorizontalStackLayout Spacing="6">
            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Success}" VerticalOptions="Center" />
            <Label Text="Donneur disponible" Style="{StaticResource Caption}" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </VerticalStackLayout>

        <Border Grid.Column="2" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="8,4"
                StrokeShape="RoundRectangle 12" VerticalOptions="Start">
          <HorizontalStackLayout Spacing="4">
            <Image Source="camp_pin" WidthRequest="13" HeightRequest="13" VerticalOptions="Center" />
            <Label Text="{Binding DistanceText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Border>
      </Grid>
      <Button Text="Voir le donneur" Command="{Binding OpenCommand}" Style="{StaticResource SmallButton}" />
    </VerticalStackLayout>
  </Border>
</ContentView>