<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.DonationCard"
             x:DataType="items:DonationItem">
  <Border Style="{StaticResource Card}">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Border WidthRequest="44" HeightRequest="44" VerticalOptions="Start"
              BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
        <Image Source="camp_drop" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
      </Border>

      <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
        <Label Text="Don de sang" FontAttributes="Bold" FontSize="16" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <Image Source="camp_hospital" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
          <Label Grid.Column="1" Text="{Binding StructureName}" Style="{StaticResource Subtitle}" LineBreakMode="TailTruncation" MaxLines="1" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <Image Source="camp_calendar" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
          <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
        </Grid>
      </VerticalStackLayout>

      <VerticalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End">
        <Image Source="icon_check" WidthRequest="22" HeightRequest="22" HorizontalOptions="End" />
        <Border BackgroundColor="{StaticResource SuccessLight}" StrokeThickness="0" Padding="8,3"
                StrokeShape="RoundRectangle 10" HorizontalOptions="End" IsVisible="{Binding HasVolume}">
          <Label Text="{Binding VolumeText}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Success}" />
        </Border>
      </VerticalStackLayout>
    </Grid>
  </Border>
</ContentView>