<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GyBlood.Mobile.Views.Controls.ImageFrame">
  <!--
    CADRE D'IMAGE : tant que Source est vide, un cadre pointillé avec sa légende marque l'emplacement.
    Pour mettre l'image : ajoutez le fichier dans Resources/Images puis renseignez Source="nom_du_fichier.png"
    (ou une URL https). La taille se règle avec HeightRequest / WidthRequest sur le contrôle.
  -->
  <Grid>
    <Border x:Name="Placeholder"
            BackgroundColor="{StaticResource Gray100}"
            Stroke="{StaticResource Gray400}"
            StrokeThickness="1"
            StrokeDashArray="4,3"
            StrokeShape="RoundRectangle 12">
      <Label x:Name="CaptionLabel"
             Text="Image"
             FontSize="11"
             TextColor="{StaticResource Gray500}"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             HorizontalTextAlignment="Center"
             Margin="6" />
    </Border>
    <Border x:Name="PictureHost" StrokeThickness="0" StrokeShape="RoundRectangle 12" IsVisible="False">
      <Image x:Name="Picture" Aspect="AspectFill" />
    </Border>
  </Grid>
</ContentView>
