<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.NotificationCard"
             x:DataType="items:NotificationItem">
  <Border Style="{StaticResource Card}">
    <Border.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding OpenCommand}" />
    </Border.GestureRecognizers>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

      <!-- Cloche + pastille rouge si non lue -->
      <Grid VerticalOptions="Start" WidthRequest="48" HeightRequest="48">
        <Border WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" VerticalOptions="End"
                BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
          <Image Source="card_bell" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" HorizontalOptions="End" VerticalOptions="Start"
                 Color="{StaticResource Primary}" IsVisible="{Binding IsUnread}" />
      </Grid>

      <VerticalStackLayout Grid.Column="1" Spacing="4">
        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
        <Label Text="{Binding Message}" Style="{StaticResource Subtitle}" MaxLines="3" LineBreakMode="TailTruncation" />
        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
          <Image Source="card_clock" WidthRequest="13" HeightRequest="13" VerticalOptions="Center" />
          <Label Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
        </HorizontalStackLayout>
      </VerticalStackLayout>
    </Grid>
  </Border>
</ContentView>