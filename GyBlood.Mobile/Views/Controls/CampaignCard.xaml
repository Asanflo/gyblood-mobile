<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.CampaignCard"
             x:DataType="items:CampaignItem">
  <Border Style="{StaticResource Card}" Padding="0">
    <Border.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding OpenCommand}" />
    </Border.GestureRecognizers>

    <VerticalStackLayout Spacing="0">

      <!-- ===== Bandeau : illustration par défaut, remplacée par l'affiche si elle existe ===== -->
      <Grid HeightRequest="150">
        <Image Source="camp_banner" Aspect="AspectFill" />
        <Image Source="{Binding ImageUrl}" IsVisible="{Binding HasImage}" Aspect="AspectFill" />

        <!-- Date sur l'image -->
        <Border HorizontalOptions="Start" VerticalOptions="End" Margin="12"
                BackgroundColor="#F2FFFFFF" StrokeThickness="0" Padding="10,5"
                StrokeShape="RoundRectangle 14">
          <HorizontalStackLayout Spacing="6">
            <Image Source="camp_calendar" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
            <Label Text="{Binding PeriodText}" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Border>

        <!-- Badge « Inscrit » -->
        <controls:StatusChip Text="Inscrit" ChipColor="{StaticResource Success}"
                             IsVisible="{Binding IsJoined}"
                             HorizontalOptions="End" VerticalOptions="Start" Margin="12" />
      </Grid>

      <!-- ===== Informations ===== -->
      <VerticalStackLayout Padding="14,12,14,14" Spacing="10">
        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17"
               TextColor="{StaticResource Gray900}" MaxLines="2" LineBreakMode="TailTruncation" />

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Image Source="camp_hospital" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
          <Label Grid.Column="1" Text="{Binding StructureName}" Style="{StaticResource Subtitle}"
                 VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Image Source="camp_pin" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
          <Label Grid.Column="1" Text="{Binding Location}" Style="{StaticResource Caption}"
                 VerticalOptions="Center" MaxLines="2" LineBreakMode="TailTruncation" />
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource Stroke}" Margin="0,2" />

        <!-- Objectif et fonds -->
        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
          <Border BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" Padding="10,6"
                  StrokeShape="RoundRectangle 16" Margin="0,0,8,6">
            <HorizontalStackLayout Spacing="6">
              <Image Source="camp_drop" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
              <Label Text="{Binding TargetText}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Primary}" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>

          <Border BackgroundColor="{StaticResource WarningLight}" StrokeThickness="0" Padding="10,6"
                  StrokeShape="RoundRectangle 16" Margin="0,0,0,6"
                  IsVisible="{Binding FundsText, Converter={StaticResource StringNotEmpty}}">
            <HorizontalStackLayout Spacing="6">
              <Image Source="camp_coins" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
              <Label Text="{Binding FundsText}" FontSize="13" FontAttributes="Bold"
                     TextColor="{StaticResource Warning}" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>
        </FlexLayout>
      </VerticalStackLayout>

    </VerticalStackLayout>
  </Border>
</ContentView>