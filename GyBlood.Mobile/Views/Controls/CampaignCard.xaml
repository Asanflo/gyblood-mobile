<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.CampaignCard"
             x:DataType="items:CampaignItem">
  <Border Style="{StaticResource Card}" Padding="0">
    <Border.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding OpenCommand}" />
    </Border.GestureRecognizers>
    <VerticalStackLayout Spacing="0">
      <!-- IMAGE : visuel de la campagne -->
      <controls:ImageFrame HeightRequest="96" Caption="Visuel de la campagne" CornerRadius="0" />
      <VerticalStackLayout Padding="14" Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
          <controls:StatusChip Grid.Column="1" Text="Inscrit" ChipColor="{StaticResource Success}" IsVisible="{Binding IsJoined}" />
        </Grid>
        <Label Text="{Binding StructureName}" Style="{StaticResource Subtitle}" />
        <Label Text="{Binding PeriodText}" Style="{StaticResource Caption}" />
        <Label Text="{Binding Location}" Style="{StaticResource Caption}" />
        <Label Text="{Binding TargetText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,4,0,0" />
        <Label Text="{Binding FundsText}" Style="{StaticResource Caption}" IsVisible="{Binding FundsText, Converter={StaticResource StringNotEmpty}}" />
      </VerticalStackLayout>
    </VerticalStackLayout>
  </Border>
</ContentView>
