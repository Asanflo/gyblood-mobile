<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Controls.AccountCard"
             x:DataType="items:AccountItem">
  <Border Style="{StaticResource Card}">
    <Border.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding OpenCommand}" />
    </Border.GestureRecognizers>
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
      <Label Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" />
      <controls:StatusChip Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" ChipColor="{Binding StatusColor}" />
      <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Email}" Style="{StaticResource Subtitle}" />
      <Label Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Caption}">
        <Label.FormattedText>
          <FormattedString>
            <Span Text="{Binding RoleText}" />
            <Span Text=" · " />
            <Span Text="{Binding DateText}" />
          </FormattedString>
        </Label.FormattedText>
      </Label>
    </Grid>
  </Border>
</ContentView>
