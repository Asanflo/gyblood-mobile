<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Patient.BookAppointmentPage"
             x:DataType="vm:BookAppointmentViewModel"
             Title="Demander un don"
             Shell.NavBarIsVisible="True">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="16">

      <Border Style="{StaticResource SoftCard}">
        <Grid ColumnDefinitions="*,Auto">
          <VerticalStackLayout Spacing="2">
            <Label Text="Donneur" Style="{StaticResource Caption}" />
            <Label Text="{Binding DonorName}" FontAttributes="Bold" />
          </VerticalStackLayout>
          <Border Grid.Column="1" BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14,6" VerticalOptions="Center">
            <Label Text="{Binding BloodText}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
          </Border>
        </Grid>
      </Border>

      <controls:PickerField Header="Structure de santé" IsRequired="True" Title="Choisir une structure"
                            ItemsSource="{Binding Structures}" SelectedItem="{Binding SelectedStructure}" />

      <VerticalStackLayout Spacing="6">
        <Label Text="Date du rendez-vous *" FontSize="13" FontAttributes="Bold" />
        <Border Style="{StaticResource FieldBorder}">
          <DatePicker Date="{Binding Date}" MinimumDate="{Binding MinimumDate}" Format="dd MMMM yyyy" />
        </Border>
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="6">
        <Label Text="Heure *" FontSize="13" FontAttributes="Bold" />
        <Border Style="{StaticResource FieldBorder}">
          <TimePicker Time="{Binding Time}" Format="HH:mm" />
        </Border>
      </VerticalStackLayout>

      <Border Style="{StaticResource SoftCard}">
        <Label Text="Les frais d'entretien et d'examens sont fixés par la structure. Vous les réglez par Mobile Money une fois que le donneur a accepté."
               Style="{StaticResource Subtitle}" />
      </Border>

      <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      <Button Text="Envoyer la demande" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsNotBusy}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
