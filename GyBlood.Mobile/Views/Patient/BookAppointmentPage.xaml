<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             x:Class="GyBlood.Mobile.Views.Patient.BookAppointmentPage"
             x:DataType="vm:BookAppointmentViewModel"
             Title="Réservation">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Réservation" Style="{StaticResource Heading}" />
      <Label Text="Hôpital le plus proche proposé par défaut, choix du créneau. (US-14)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
