<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Patient.PatientHomePage"
             x:DataType="vm:PatientHomeViewModel"
             Title="Accueil"
             Shell.NavBarIsVisible="False">
  <ScrollView>
    <VerticalStackLayout Padding="20,16,20,24" Spacing="16">

      <!-- En-tête : salutation + notifications + profil -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
          <Label Text="{Binding Greeting}" Style="{StaticResource Heading}" FontSize="22" />
          <Label Text="Ensemble, sauvons des vies" TextColor="{StaticResource Primary}" FontSize="13" />
        </VerticalStackLayout>
        <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource PrimaryLight}" VerticalOptions="Center">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
          </Border.GestureRecognizers>
          <Image Source="icon_bell" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <Border Grid.Column="2" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource PrimaryLight}" VerticalOptions="Center">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
          </Border.GestureRecognizers>
          <Image Source="icon_user" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
      </Grid>

      <!-- Bandeau rouge -->
      <Border Style="{StaticResource Banner}">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding OpenBannerCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <VerticalStackLayout Spacing="4" VerticalOptions="Center">
            <Label Text="{Binding BannerTitle}" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="18" />
            <Label Text="{Binding BannerSubtitle}" TextColor="{StaticResource White}" FontSize="13" />
          </VerticalStackLayout>
          <Image Grid.Column="1" Source="icon_drop" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" VerticalOptions="Center" />
        </Grid>
      </Border>

      <!-- Accès rapides -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
        <controls:ActionTile Grid.Row="0" Grid.Column="0" Icon="action_request" Title="Demander du sang" Subtitle="Trouver un donneur" Command="{Binding OpenMapCommand}" />
        <controls:ActionTile Grid.Row="0" Grid.Column="1" Icon="action_stock" Title="Consulter les stocks" Subtitle="Banques de sang" Command="{Binding OpenStocksCommand}" />
        <controls:ActionTile Grid.Row="1" Grid.Column="0" Icon="action_campaign" Title="Campagnes" Subtitle="À proximité" Command="{Binding OpenCampaignsCommand}" />
        <controls:ActionTile Grid.Row="1" Grid.Column="1" Icon="action_map" Title="Carte des donneurs" Subtitle="Autour de moi" Command="{Binding OpenMapCommand}" />
      </Grid>

      <!-- Rendez-vous en cours -->
      <Border Style="{StaticResource SoftCard}">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding OpenAppointmentsCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto">
          <VerticalStackLayout Spacing="2">
            <Label Text="Mes rendez-vous" FontAttributes="Bold" />
            <Label Text="{Binding AppointmentsText}" Style="{StaticResource Subtitle}" />
          </VerticalStackLayout>
          <Label Grid.Column="1" Text="Voir →" Style="{StaticResource LinkLabel}" VerticalOptions="Center" />
        </Grid>
      </Border>

      <!-- Campagnes -->
      <Grid ColumnDefinitions="*,Auto">
        <Label Text="Campagnes de don de sang" Style="{StaticResource SectionTitle}" />
        <Label Grid.Column="1" Text="Voir tout →" Style="{StaticResource LinkLabel}" FontSize="13">
          <Label.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCampaignsCommand}" />
          </Label.GestureRecognizers>
        </Label>
      </Grid>
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Campaigns}" IsVisible="{Binding HasCampaigns}" Spacing="12">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="items:CampaignItem">
            <controls:CampaignCard />
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>

      <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>