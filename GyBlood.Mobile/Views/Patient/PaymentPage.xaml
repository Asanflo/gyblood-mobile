<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Patient.PaymentPage"
             x:DataType="vm:PaymentViewModel"
             Title="Paiement"
             Shell.NavBarIsVisible="True">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="16">

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Récapitulatif" Style="{StaticResource SectionTitle}" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
            <Label Grid.Row="0" Text="Donneur" Style="{StaticResource Caption}" />
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding DonorName}" HorizontalOptions="End" />
            <Label Grid.Row="1" Text="Structure" Style="{StaticResource Caption}" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding StructureName}" HorizontalOptions="End" />
            <Label Grid.Row="2" Text="Date" Style="{StaticResource Caption}" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DateText}" HorizontalOptions="End" />
          </Grid>
          <BoxView HeightRequest="1" Color="{StaticResource Stroke}" />
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="Frais d'entretien et d'examens" />
            <Label Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="18" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <VerticalStackLayout Spacing="12" IsVisible="{Binding CanEdit}">
        <Label Text="Payer avec" Style="{StaticResource SectionTitle}" />
        <controls:OperatorSelector Selected="{Binding SelectedOperator}" />
        <controls:FormField Header="Numéro Mobile Money" IsRequired="True" Placeholder="6XX XXX XXX" KeyboardType="Telephone" Text="{Binding PhoneNumber}" />
      </VerticalStackLayout>

      <Label Text="{Binding ResultMessage}" TextColor="{StaticResource Success}" FontAttributes="Bold"
             IsVisible="{Binding ResultMessage, Converter={StaticResource StringNotEmpty}}" />
      <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />

      <Button Text="{Binding PayButtonText}" Command="{Binding PayCommand}" IsEnabled="{Binding IsNotBusy}" IsVisible="{Binding CanEdit}" />
      <Button Text="Terminé" Command="{Binding DoneCommand}" IsVisible="{Binding IsFinished}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

      <Label Text="La somme est versée à la structure de santé ; GyBlood en déduit ses frais de service." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
