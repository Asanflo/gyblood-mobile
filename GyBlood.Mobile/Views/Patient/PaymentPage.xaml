<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             x:Class="GyBlood.Mobile.Views.Patient.PaymentPage"
             x:DataType="vm:PaymentViewModel"
             Title="Paiement">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Paiement" Style="{StaticResource Heading}" />
      <Label Text="Montant, frais de la plateforme, opérateur MoMo ou Orange Money. (US-15)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
