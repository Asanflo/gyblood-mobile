<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             x:Class="GyBlood.Mobile.Views.Patient.StocksPage"
             x:DataType="vm:StocksViewModel"
             Title="Stocks de sang">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Stocks de sang" Style="{StaticResource Heading}" />
      <Label Text="Liste filtrable par groupe et rhésus, distance, date de mise à jour. (US-10)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
