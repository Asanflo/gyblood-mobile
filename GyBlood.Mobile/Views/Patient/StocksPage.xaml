<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Patient.StocksPage"
             x:DataType="vm:StocksViewModel"
             Title="Stocks de sang"
             Shell.NavBarIsVisible="True">
  <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
    <Grid RowDefinitions="Auto,Auto,*">

      <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,12,20,4">
        <controls:PickerField Grid.Column="0" Header="Groupe" Title="Groupe" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding SelectedGroup}" />
        <controls:PickerField Grid.Column="1" Header="Rhésus" Title="Rhésus" ItemsSource="{Binding RhesusChoices}" SelectedItem="{Binding SelectedRhesus}" />
      </Grid>

      <VerticalStackLayout Grid.Row="1" Padding="20,4" Spacing="2">
        <Label Text="{Binding CountText}" FontAttributes="Bold" />
        <Label Text="Du plus proche au plus éloigné quand la localisation est activée." Style="{StaticResource Caption}" />
        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      </VerticalStackLayout>

      <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="items:StockItem">
            <controls:StockCard Margin="20,0" />
          </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
          <controls:EmptyState Message="Aucun stock publié pour ce groupe." />
        </CollectionView.EmptyView>
        <CollectionView.Footer>
          <Label Text="Les stocks peuvent varier. Confirmez la disponibilité auprès du centre avant de vous déplacer."
                 Style="{StaticResource Caption}" Margin="20,12,20,24" HorizontalTextAlignment="Center" />
        </CollectionView.Footer>
      </CollectionView>
    </Grid>
  </RefreshView>
</ContentPage>
