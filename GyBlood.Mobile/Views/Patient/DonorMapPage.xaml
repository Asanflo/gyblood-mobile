<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Patient.DonorMapPage"
             x:DataType="vm:DonorMapViewModel"
             Title="Carte des donneurs"
             Shell.NavBarIsVisible="True">
  <Grid RowDefinitions="Auto,*">

    <!-- Rayon de recherche et résumé -->
    <VerticalStackLayout Grid.Row="0" Padding="16,10,16,10" Spacing="8">
      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
        <controls:PickerField Grid.Column="0" Header="Groupe recherché" Title="Groupe" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding SelectedGroup}" />
        <controls:PickerField Grid.Column="1" Header="Rhésus" Title="Rhésus" ItemsSource="{Binding RhesusChoices}" SelectedItem="{Binding SelectedRhesus}" />
        <Button Grid.Column="2" Text="Chercher" Command="{Binding SearchCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SmallButton}" VerticalOptions="End" />
      </Grid>
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
        <Button Grid.Column="0" Text="5 km" Command="{Binding SetRadiusCommand}" CommandParameter="5" Style="{StaticResource SmallOutlineButton}" />
        <Button Grid.Column="1" Text="10 km" Command="{Binding SetRadiusCommand}" CommandParameter="10" Style="{StaticResource SmallOutlineButton}" />
        <Button Grid.Column="2" Text="15 km" Command="{Binding SetRadiusCommand}" CommandParameter="15" Style="{StaticResource SmallOutlineButton}" />
        <Button Grid.Column="3" Text="20 km" Command="{Binding SetRadiusCommand}" CommandParameter="20" Style="{StaticResource SmallOutlineButton}" />
      </Grid>
      <Label Text="{Binding Summary}" Style="{StaticResource Subtitle}" />
      <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
    </VerticalStackLayout>

    <!-- Carte + carrousel des donneurs en bas (comme la fiche « Besoin de O+ » des maquettes) -->
    <!-- Carte + boutons + légende + carrousel des donneurs -->
    <Grid Grid.Row="1">
      <controls:DonorMapView x:Name="Map" />

      <!-- Légende -->
      <Border VerticalOptions="Start" HorizontalOptions="Start" Margin="12,12,0,0" Padding="10,6"
              BackgroundColor="#E6FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 14">
        <VerticalStackLayout Spacing="4">
          <HorizontalStackLayout Spacing="6">
            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" Color="#1E88E5" VerticalOptions="Center" />
            <Label Text="Vous" FontSize="12" VerticalOptions="Center" />
          </HorizontalStackLayout>
          <HorizontalStackLayout Spacing="6">
            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" Color="#D50000" VerticalOptions="Center" />
            <Label Text="Donneur (groupe)" FontSize="12" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Border>

      <!-- Zoom et recentrage -->
      <VerticalStackLayout VerticalOptions="Start" HorizontalOptions="End" Margin="0,12,12,0" Spacing="8">
        <Button Text="+" Clicked="OnZoomInClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="22" CornerRadius="22" />
        <Button Text="−" Clicked="OnZoomOutClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="22" CornerRadius="22" />
        <Button Text="◎" Command="{Binding LocateCommand}" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20" CornerRadius="22" />
      </VerticalStackLayout>

      <CollectionView x:Name="DonorList"
                      ItemsSource="{Binding Donors}"
                      IsVisible="{Binding HasDonors}"
                      VerticalOptions="End"
                      HeightRequest="140"
                      Margin="0,0,0,12"
                      ItemsLayout="HorizontalList"
                      HorizontalScrollBarVisibility="Never">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="items:DonorItem">
            <controls:DonorCard Margin="12,0,0,0" />
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
  </Grid>
</ContentPage>
