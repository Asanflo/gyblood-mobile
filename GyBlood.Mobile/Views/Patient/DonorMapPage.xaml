<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Patient.DonorMapPage"
             x:DataType="vm:DonorMapViewModel"
             Title="Carte des donneurs">
  <Grid RowDefinitions="Auto,*">
    <VerticalStackLayout Grid.Row="0" Padding="12" Spacing="4">
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
    <controls:DonorMapView Grid.Row="1" />
  </Grid>
</ContentPage>
