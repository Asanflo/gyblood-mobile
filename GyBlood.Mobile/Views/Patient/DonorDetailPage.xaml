<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             x:Class="GyBlood.Mobile.Views.Patient.DonorDetailPage"
             x:DataType="vm:DonorDetailViewModel"
             Title="Détail d'un donneur">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Détail d'un donneur" Style="{StaticResource Heading}" />
      <Label Text="Nom, groupe, rhésus, distance et bouton « Demander un don ». (US-13)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
