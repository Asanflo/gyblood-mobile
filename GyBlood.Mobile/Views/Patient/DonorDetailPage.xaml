<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Patient"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Patient.DonorDetailPage"
             x:DataType="vm:DonorDetailViewModel"
             Title="Donneur"
             Shell.NavBarIsVisible="True">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="16">
      <Image Source="avatar_donor" WidthRequest="96" HeightRequest="96" Aspect="AspectFit" HorizontalOptions="Center" />
      <Label Text="{Binding Name}" Style="{StaticResource Heading}" HorizontalOptions="Center" />

      <Border BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="22,8" HorizontalOptions="Center">
        <Label Text="{Binding BloodText}" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="26" />
      </Border>
      <Label Text="{Binding DistanceText}" Style="{StaticResource Subtitle}" HorizontalOptions="Center" />

      <Border Style="{StaticResource SoftCard}">
        <Label Text="Pour protéger votre vie privée, le donneur voit uniquement votre groupe sanguin et la distance qui vous sépare, jamais votre identité."
               Style="{StaticResource Subtitle}" />
      </Border>

      <Button Text="Demander un don" Command="{Binding RequestDonationCommand}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
