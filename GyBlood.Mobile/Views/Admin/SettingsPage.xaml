<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Admin"
             x:Class="GyBlood.Mobile.Views.Admin.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Paramètres">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Paramètres" Style="{StaticResource Heading}" />
      <Label Text="Délai minimal entre deux dons par sexe et type de don. (US-53)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
