<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Admin"
             x:Class="GyBlood.Mobile.Views.Admin.AccountDetailPage"
             x:DataType="vm:AccountDetailViewModel"
             Title="Détail d'un compte">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Détail d'un compte" Style="{StaticResource Heading}" />
      <Label Text="Document de groupe sanguin, valider, refuser, suspendre. (US-50, US-51, US-52)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
