<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Admin"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Admin.PendingAccountsPage"
             x:DataType="vm:PendingAccountsViewModel"
             Title="Comptes"
             Shell.NavBarIsVisible="True">
  <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
    <Grid RowDefinitions="Auto,Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,12,20,4">
        <controls:PickerField Grid.Column="0" Header="Statut" Title="Statut" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding SelectedStatus}" />
        <controls:PickerField Grid.Column="1" Header="Rôle" Title="Rôle" ItemsSource="{Binding RoleChoices}" SelectedItem="{Binding SelectedRole}" />
      </Grid>
      <VerticalStackLayout Grid.Row="1" Padding="20,4" Spacing="2">
        <Label Text="{Binding CountText}" FontAttributes="Bold" />
        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      </VerticalStackLayout>
      <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="items:AccountItem">
            <controls:AccountCard Margin="20,0" />
          </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
          <controls:EmptyState Message="Aucun compte ne correspond à ces filtres." />
        </CollectionView.EmptyView>
        <CollectionView.Footer>
          <BoxView HeightRequest="16" Color="Transparent" />
        </CollectionView.Footer>
      </CollectionView>
    </Grid>
  </RefreshView>
</ContentPage>
