<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Admin"
             x:Class="GyBlood.Mobile.Views.Admin.PendingAccountsPage"
             x:DataType="vm:PendingAccountsViewModel"
             Title="Comptes à valider">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Comptes à valider" Style="{StaticResource Heading}" />
      <Label Text="Comptes donneurs et structures en attente. (US-50, US-51)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
