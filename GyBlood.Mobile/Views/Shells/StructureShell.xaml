<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GyBlood.Mobile.Views.Shells.StructureShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:GyBlood.Mobile.Views.Structure"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Primary}"
       Shell.ForegroundColor="{StaticResource White}"
       Shell.TitleColor="{StaticResource White}"
       Shell.TabBarBackgroundColor="{StaticResource White}"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{StaticResource Gray500}">

  <TabBar>
    <ShellContent Title="Stocks" Route="structure-stocks" ContentTemplate="{DataTemplate pages:StockEditorPage}" />
    <ShellContent Title="Rendez-vous" Route="structure-appointments" ContentTemplate="{DataTemplate pages:StructureAppointmentsPage}" />
    <ShellContent Title="Campagnes" Route="structure-campaigns" ContentTemplate="{DataTemplate pages:StructureCampaignsPage}" />
    <ShellContent Title="Profil" Route="structure-profile" ContentTemplate="{DataTemplate pages:StructureProfilePage}" />
  </TabBar>

</Shell>
