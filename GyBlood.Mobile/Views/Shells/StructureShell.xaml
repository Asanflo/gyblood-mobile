<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GyBlood.Mobile.Views.Shells.StructureShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:GyBlood.Mobile.Views.Structure"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource White}"
       Shell.ForegroundColor="{StaticResource Primary}"
       Shell.TitleColor="{StaticResource Gray900}"
       Shell.TabBarBackgroundColor="{StaticResource White}"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{StaticResource Gray500}">

  <!-- Onglets : les icônes (Icon="...") seront ajoutées une fois les images prêtes. -->
  <TabBar>
    <ShellContent Title="Accueil" Icon="tab_home" Route="structure-home" ContentTemplate="{DataTemplate pages:StructureDashboardPage}" />
    <ShellContent Title="Rendez-vous" Icon="tab_appointments" Route="structure-appointments" ContentTemplate="{DataTemplate pages:StructureAppointmentsPage}" />
    <ShellContent Title="Campagnes" Icon="tab_campaign" Route="structure-campaigns" ContentTemplate="{DataTemplate pages:StructureCampaignsPage}" />
    <ShellContent Title="Profil" Icon="tab_profile" Route="structure-profile" ContentTemplate="{DataTemplate pages:StructureProfilePage}" />
  </TabBar>

</Shell>
