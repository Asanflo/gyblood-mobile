<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GyBlood.Mobile.Views.Shells.AdminShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:GyBlood.Mobile.Views.Admin"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Primary}"
       Shell.ForegroundColor="{StaticResource White}"
       Shell.TitleColor="{StaticResource White}"
       Shell.TabBarBackgroundColor="{StaticResource White}"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{StaticResource Gray500}">

  <TabBar>
    <ShellContent Title="À valider" Route="admin-pending" ContentTemplate="{DataTemplate pages:PendingAccountsPage}" />
    <ShellContent Title="Paramètres" Route="admin-settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
  </TabBar>

</Shell>
