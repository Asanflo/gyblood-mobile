<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Auth"
             x:Class="GyBlood.Mobile.Views.Auth.RoleChoicePage"
             x:DataType="vm:RoleChoiceViewModel"
             Title="Choix du rôle">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Choix du rôle" Style="{StaticResource Heading}" />
      <Label Text="Affiché après une première connexion Google : choisir patient, donneur, banque de sang ou sponsor. (US-02)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
