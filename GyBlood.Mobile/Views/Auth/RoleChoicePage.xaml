<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Auth"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Auth.RoleChoicePage"
             x:DataType="vm:RoleChoiceViewModel"
             Title="Votre profil"
             Shell.NavBarIsVisible="True">
  <Grid RowDefinitions="*,Auto">
    <ScrollView>
      <VerticalStackLayout Padding="20,12,20,12" Spacing="12">
        <Label Text="Quel est votre profil ?" Style="{StaticResource Heading}" />
        <Label Text="Choisissez comment vous utiliserez GyBlood." Style="{StaticResource Subtitle}" />

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Roles}" Spacing="12" Margin="0,8,0,0">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="items:RoleCardItem">
              <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding SelectCommand}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                  <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                  </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                  <!-- Pastille de sélection (se remplit quand le profil est choisi) -->
                  <Border Grid.Column="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Start"
                          StrokeShape="RoundRectangle 11" Stroke="{StaticResource Gray400}" StrokeThickness="2" BackgroundColor="Transparent">
                    <Border.Triggers>
                      <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                      </DataTrigger>
                    </Border.Triggers>
                  </Border>
                  <!-- Icône SVG du profil (Resources/Images/role_*.svg) -->
                  <Image Grid.Column="1" Source="{Binding IconSource}" WidthRequest="32" HeightRequest="32" VerticalOptions="Start" />
                  <VerticalStackLayout Grid.Column="2" Spacing="4">
                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                    <Label Text="{Binding Description}" Style="{StaticResource Subtitle}" />
                  </VerticalStackLayout>
                </Grid>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      </VerticalStackLayout>
    </ScrollView>

    <Button Grid.Row="1" Text="Continuer" Command="{Binding ContinueCommand}" IsEnabled="{Binding HasSelection}" Margin="20,8,20,20" />
  </Grid>
</ContentPage>
