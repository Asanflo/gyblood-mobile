<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Auth"
             xmlns:behaviors="clr-namespace:GyBlood.Mobile.Behaviors"
             x:Class="GyBlood.Mobile.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Créer un compte">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="14">
      <Label Text="Créer un compte" Style="{StaticResource Heading}" />

      <Picker Title="Je suis" ItemsSource="{Binding Roles}"
              ItemDisplayBinding="{Binding Label, x:DataType=vm:RoleOption}"
              SelectedItem="{Binding SelectedRole}" />
      <Entry Placeholder="Adresse email" Keyboard="Email" Text="{Binding Email}">
        <Entry.Behaviors>
          <behaviors:EmailValidationBehavior />
        </Entry.Behaviors>
      </Entry>
      <Entry Placeholder="Mot de passe (8 caractères minimum)" IsPassword="True" Text="{Binding Password}">
        <Entry.Behaviors>
          <behaviors:PasswordValidationBehavior />
        </Entry.Behaviors>
      </Entry>
      <Entry Placeholder="Confirmer le mot de passe" IsPassword="True" Text="{Binding ConfirmPassword}" />

      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />

      <Button Text="Créer mon compte" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" />
      <Button Text="S'inscrire avec Google" Style="{StaticResource OutlineButton}" Command="{Binding RegisterWithGoogleCommand}" IsEnabled="{Binding IsNotBusy}" />
      <Button Text="J'ai déjà un compte" Style="{StaticResource LinkButton}" Command="{Binding BackToLoginCommand}" />

      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
