<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Auth"
             xmlns:behaviors="clr-namespace:GyBlood.Mobile.Behaviors"
             x:Class="GyBlood.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Connexion">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
      <Label Text="GyBlood" Style="{StaticResource Heading}" HorizontalOptions="Center" />
      <Label Text="Donner son sang, sauver des vies" HorizontalOptions="Center" TextColor="{StaticResource Gray600}" />

      <Entry Placeholder="Adresse email" Keyboard="Email" Text="{Binding Email}">
        <Entry.Behaviors>
          <behaviors:EmailValidationBehavior />
        </Entry.Behaviors>
      </Entry>
      <Entry Placeholder="Mot de passe" IsPassword="True" Text="{Binding Password}" />

      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />

      <Button Text="Se connecter" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" />
      <Button Text="Continuer avec Google" Style="{StaticResource OutlineButton}" Command="{Binding LoginWithGoogleCommand}" IsEnabled="{Binding IsNotBusy}" />
      <Button Text="Créer un compte" Style="{StaticResource LinkButton}" Command="{Binding GoToRegisterCommand}" />

      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
