<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Auth"
             x:Class="GyBlood.Mobile.Views.Auth.PendingAccountPage"
             x:DataType="vm:PendingAccountViewModel"
             Title="Compte en attente">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
      <Label Text="Compte en attente" Style="{StaticResource Heading}" HorizontalOptions="Center" />
      <Label Text="{Binding StatusMessage}" HorizontalTextAlignment="Center" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />

      <Button Text="Actualiser" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" />
      <Button Text="Se déconnecter" Style="{StaticResource OutlineButton}" Command="{Binding LogoutCommand}" />

      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
