<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Structure"
             x:Class="GyBlood.Mobile.Views.Structure.StructureProfilePage"
             x:DataType="vm:StructureProfileViewModel"
             Title="Profil de la structure">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Profil de la structure" Style="{StaticResource Heading}" />
      <Label Text="Nom, adresse, position, téléphone, justificatif. (US-30)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
