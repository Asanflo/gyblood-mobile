<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Structure"
             x:Class="GyBlood.Mobile.Views.Structure.StructureAppointmentsPage"
             x:DataType="vm:StructureAppointmentsViewModel"
             Title="Rendez-vous">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Rendez-vous" Style="{StaticResource Heading}" />
      <Label Text="Liste des rendez-vous, confirmation du don, absence. (US-33)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
