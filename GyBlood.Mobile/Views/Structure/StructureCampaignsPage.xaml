<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Structure"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Structure.StructureCampaignsPage"
             x:DataType="vm:StructureCampaignsViewModel"
             Title="Campagnes"
             Shell.NavBarIsVisible="True">
  <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
    <Grid RowDefinitions="Auto,Auto,*">
      <Button Grid.Row="0" Text="+ Nouvelle campagne" Command="{Binding CreateCommand}" Margin="20,12,20,4" />
      <Label Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" Margin="20,4"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" Margin="0,8,0,0">
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="items:CampaignItem">
            <controls:CampaignCard Margin="20,0" />
          </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
          <controls:EmptyState Message="Vous n'avez publié aucune campagne." />
        </CollectionView.EmptyView>
        <CollectionView.Footer>
          <BoxView HeightRequest="16" Color="Transparent" />
        </CollectionView.Footer>
      </CollectionView>
    </Grid>
  </RefreshView>
</ContentPage>
