<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Structure"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Structure.CampaignEditorPage"
             x:DataType="vm:CampaignEditorViewModel"
             Title="Nouvelle campagne"
             Shell.NavBarIsVisible="True">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <!-- Visuel de la campagne : boîte d'ajout d'image -->
      <VerticalStackLayout Spacing="6">
        <Label Text="Visuel de la campagne" FontSize="13" FontAttributes="Bold" />

        <!-- Aucune image : boîte à toucher -->
        <Border IsVisible="{Binding HasNoImage}" Stroke="{StaticResource Gray300}" StrokeThickness="1.5"
                StrokeDashArray="4,3" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Gray100}"
                Padding="16" HeightRequest="140">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding PickImageCommand}" />
          </Border.GestureRecognizers>
          <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
            <Image Source="icon_upload" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
            <Label Text="Touchez pour ajouter une image" FontSize="13" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Border>

        <!-- Image choisie : aperçu et actions -->
        <VerticalStackLayout IsVisible="{Binding HasImage}" Spacing="8">
          <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="160">
            <Image Source="{Binding ImagePreview}" Aspect="AspectFill" />
          </Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Changer" Command="{Binding PickImageCommand}" Style="{StaticResource SmallOutlineButton}" />
            <Button Grid.Column="1" Text="Retirer" Command="{Binding RemoveImageCommand}" Style="{StaticResource LinkButton}" />
          </Grid>
        </VerticalStackLayout>

        <Label Text="PNG ou JPG, 5 Mo maximum." Style="{StaticResource Caption}" />
      </VerticalStackLayout>

      <controls:FormField Header="Titre" IsRequired="True" Placeholder="Ex. Grande collecte de sang" Text="{Binding CampaignTitle}" />
      <controls:FormField Header="Lieu" IsRequired="True" Placeholder="Ex. Place du gouvernement, Douala" Text="{Binding Location}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <VerticalStackLayout Spacing="6">
          <Label Text="Début *" FontSize="13" FontAttributes="Bold" />
          <Border Style="{StaticResource FieldBorder}">
            <DatePicker Date="{Binding StartDate}" MinimumDate="{Binding MinimumDate}" Format="dd/MM/yyyy" />
          </Border>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1" Spacing="6">
          <Label Text="Fin *" FontSize="13" FontAttributes="Bold" />
          <Border Style="{StaticResource FieldBorder}">
            <DatePicker Date="{Binding EndDate}" MinimumDate="{Binding MinimumDate}" Format="dd/MM/yyyy" />
          </Border>
        </VerticalStackLayout>
      </Grid>

      <controls:FormField Header="Objectif (nombre de dons)" IsRequired="True" Placeholder="Ex. 100" KeyboardType="Numeric" MaxLength="5" Text="{Binding TargetText}" />

      <VerticalStackLayout Spacing="6">
        <Label Text="Description" FontSize="13" FontAttributes="Bold" />
        <Border Style="{StaticResource FieldBorder}">
          <Editor Text="{Binding Description}" Placeholder="Présentez la campagne…" AutoSize="TextChanges" MinimumHeightRequest="100" />
        </Border>
      </VerticalStackLayout>

      <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      <Button Text="Publier la campagne" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
