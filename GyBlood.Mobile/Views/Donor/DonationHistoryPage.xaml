<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Donor"
             xmlns:items="clr-namespace:GyBlood.Mobile.ViewModels.Items"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Donor.DonationHistoryPage"
             x:DataType="vm:DonationHistoryViewModel"
             Title="Mon activité"
             Shell.NavBarIsVisible="True">
  <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
    <CollectionView ItemsSource="{Binding Items}">
      <CollectionView.Header>
        <VerticalStackLayout Padding="20,12,20,8" Spacing="12">
          <Border Style="{StaticResource Banner}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding NextTitle}" TextColor="{StaticResource White}" FontSize="13" />
                <Label Text="{Binding NextText}" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="20" />
              </VerticalStackLayout>
              <Image Grid.Column="1" Source="icon_drop" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" VerticalOptions="Center" />
            </Grid>
          </Border>
          <Label Text="Historique des dons" Style="{StaticResource SectionTitle}" />
          <Label Text="{Binding CountText}" Style="{StaticResource Caption}" />
          <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                 IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
        </VerticalStackLayout>
      </CollectionView.Header>
      <CollectionView.ItemsLayout>
        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
      </CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="items:DonationItem">
          <controls:DonationCard Margin="20,0" />
        </DataTemplate>
      </CollectionView.ItemTemplate>
      <CollectionView.EmptyView>
        <controls:EmptyState Message="Vos dons apparaîtront ici après votre premier don." />
      </CollectionView.EmptyView>
      <CollectionView.Footer>
        <BoxView HeightRequest="16" Color="Transparent" />
      </CollectionView.Footer>
    </CollectionView>
  </RefreshView>
</ContentPage>
