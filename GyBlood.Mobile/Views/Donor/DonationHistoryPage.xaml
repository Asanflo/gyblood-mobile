<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Donor"
             x:Class="GyBlood.Mobile.Views.Donor.DonationHistoryPage"
             x:DataType="vm:DonationHistoryViewModel"
             Title="Historique des dons">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Historique des dons" Style="{StaticResource Heading}" />
      <Label Text="Dons passés et date du prochain don possible. (US-24, US-26)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
