<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Donor"
             x:Class="GyBlood.Mobile.Views.Donor.AvailabilityPage"
             x:DataType="vm:AvailabilityViewModel"
             Title="Disponibilité"
             Shell.NavBarIsVisible="True">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <Label Text="Êtes-vous disponible pour donner ?" Style="{StaticResource Heading}" />

      <Border Style="{StaticResource Card}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <Label Text="Je suis disponible" FontAttributes="Bold" />
            <Label Text="Vous pouvez recevoir des demandes de don." Style="{StaticResource Caption}" />
          </VerticalStackLayout>
          <Switch Grid.Column="1" IsToggled="{Binding IsAvailable}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <Label Text="Partager ma position" FontAttributes="Bold" />
            <Label Text="Nécessaire pour apparaître sur la carte des patients." Style="{StaticResource Caption}" />
          </VerticalStackLayout>
          <Switch Grid.Column="1" IsToggled="{Binding ShareLocation}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SoftCard}">
        <Label Text="{Binding Hint}" Style="{StaticResource Subtitle}" />
      </Border>

      <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
      <Button Text="Enregistrer" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
