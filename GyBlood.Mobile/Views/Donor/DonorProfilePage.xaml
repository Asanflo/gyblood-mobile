<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Donor"
             x:Class="GyBlood.Mobile.Views.Donor.DonorProfilePage"
             x:DataType="vm:DonorProfileViewModel"
             Title="Mon profil de donneur">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Mon profil de donneur" Style="{StaticResource Heading}" />
      <Label Text="Identité, antécédents, document de groupe sanguin, statut de validation. (US-20, US-21)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
