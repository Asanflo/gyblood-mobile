<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Shared"
             x:Class="GyBlood.Mobile.Views.Shared.StartupPage"
             x:DataType="vm:StartupViewModel"
             Title="GyBlood">
  <Grid>
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
      <Image Source="logo.png" HeightRequest="72" WidthRequest="72" />
      <Label Text="GyBlood" Style="{StaticResource Heading}" HorizontalOptions="Center" />
      <ActivityIndicator IsRunning="True" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
