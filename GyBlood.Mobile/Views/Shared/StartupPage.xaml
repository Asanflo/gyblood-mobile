<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Shared"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Shared.StartupPage"
             x:DataType="vm:StartupViewModel"
             Title="GyBlood"
             BackgroundColor="{StaticResource White}"
             Shell.NavBarIsVisible="False">
  <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
    <Image Source="logo" WidthRequest="120" HeightRequest="120" Aspect="AspectFit" HorizontalOptions="Center" />
    <Label Text="GyBlood" Style="{StaticResource BrandHeading}" HorizontalOptions="Center" />
    <ActivityIndicator IsRunning="True" />
  </VerticalStackLayout>
</ContentPage>
