<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Shared"
             xmlns:controls="clr-namespace:GyBlood.Mobile.Views.Controls"
             x:Class="GyBlood.Mobile.Views.Shared.CampaignDetailPage"
             x:DataType="vm:CampaignDetailViewModel"
             Title="Campagne"
             Shell.NavBarIsVisible="True">
  <ScrollView>
    <VerticalStackLayout Spacing="0">
      <!-- IMAGE : visuel de la campagne -->
      <controls:ImageFrame HeightRequest="180" Caption="Visuel de la campagne" CornerRadius="0" />

      <VerticalStackLayout Padding="20" Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Label Text="{Binding CampaignTitle}" Style="{StaticResource Heading}" FontSize="22" />
          <controls:StatusChip Grid.Column="1" Text="Inscrit" ChipColor="{StaticResource Success}" IsVisible="{Binding IsJoined}" VerticalOptions="Start" />
        </Grid>
        <Label Text="{Binding StructureName}" Style="{StaticResource Subtitle}" />

        <Border Style="{StaticResource SoftCard}">
          <VerticalStackLayout Spacing="6">
            <Label Text="{Binding PeriodText}" FontAttributes="Bold" />
            <Label Text="{Binding Location}" Style="{StaticResource Subtitle}" />
            <Label Text="{Binding TargetText}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Label Text="{Binding FundsText}" Style="{StaticResource Caption}" IsVisible="{Binding HasFunds}" />
          </VerticalStackLayout>
        </Border>

        <Label Text="À propos" Style="{StaticResource SectionTitle}" />
        <Label Text="{Binding DescriptionText}" Style="{StaticResource Subtitle}" />

        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />

        <Button Text="Je participe" Command="{Binding JoinCommand}" IsVisible="{Binding CanJoin}" IsEnabled="{Binding IsNotBusy}" />
        <Button Text="Annuler ma participation" Command="{Binding LeaveCommand}" IsVisible="{Binding CanLeave}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource OutlineButton}" />
        <Button Text="Financer cette campagne" Command="{Binding FundCommand}" IsVisible="{Binding CanFund}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
