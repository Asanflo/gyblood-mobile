<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GyBlood.Mobile.ViewModels.Shared"
             x:Class="GyBlood.Mobile.Views.Shared.CampaignDetailPage"
             x:DataType="vm:CampaignDetailViewModel"
             Title="Détail d'une campagne">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Détail d'une campagne" Style="{StaticResource Heading}" />
      <Label Text="Description, objectif, fonds reçus, adhésion. (US-25, US-41)" TextColor="{StaticResource Gray600}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
