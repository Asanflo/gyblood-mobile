<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Charte GyBlood, relevée sur les maquettes Figma. Les noms de clés existants sont conservés. -->
  <Color x:Key="Primary">#D50000</Color>
  <Color x:Key="PrimaryDark">#9B0000</Color>
  <Color x:Key="PrimaryLight">#FDECEC</Color>
  <Color x:Key="Secondary">#37474F</Color>

  <Color x:Key="White">#FFFFFF</Color>
  <Color x:Key="Black">#000000</Color>
  <Color x:Key="Gray100">#F5F5F5</Color>
  <Color x:Key="Gray200">#EEEEEE</Color>
  <Color x:Key="Gray300">#E0E0E0</Color>
  <Color x:Key="Gray400">#BDBDBD</Color>
  <Color x:Key="Gray500">#9E9E9E</Color>
  <Color x:Key="Gray600">#757575</Color>
  <Color x:Key="Gray900">#212121</Color>

  <Color x:Key="Success">#1B8A3A</Color>
  <Color x:Key="Warning">#EF6C00</Color>
  <Color x:Key="Danger">#C62828</Color>
  <Color x:Key="Info">#1565C0</Color>

  <Color x:Key="Surface">#F5F5F7</Color>
  <Color x:Key="Stroke">#E5E7EB</Color>
  <Color x:Key="Cream">#EDE4D8</Color>
  <Color x:Key="SuccessLight">#E6F4EA</Color>
  <Color x:Key="WarningLight">#FFF3E0</Color>
  <Color x:Key="DangerLight">#FDECEC</Color>
  <Color x:Key="InfoLight">#E3F0FD</Color>

  <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#B30000" Offset="0.0" />
    <GradientStop Color="#E00000" Offset="1.0" />
  </LinearGradientBrush>

</ResourceDictionary>
