  <Color x:Key="Primary">#B71C1C</Color>
  <Color x:Key="PrimaryDark">#7F0000</Color>
  <Color x:Key="PrimaryLight">#FFEBEE</Color>
  <Color x:Key="Secondary">#37474F</Color>

  <Color x:Key="White">#FFFFFF</Color>
  <Color x:Key="Black">#000000</Color>
  <Color x:Key="Gray100">#F5F5F5</Color>
  <Color x:Key="Gray200">#EEEEEE</Color>
