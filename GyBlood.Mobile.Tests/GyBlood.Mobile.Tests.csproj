<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GyBlood.Mobile.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Refit" Version="*" />
  </ItemGroup>

  <!--
    Le projet MAUI cible Android : un projet de test net10.0 ne peut pas le référencer directement.
    On compile donc ici, par lien, uniquement le code pur (sans dépendance MAUI) :
    énumérations, modèles, helpers, constantes d'API et interfaces Refit.
  -->
  <ItemGroup>
    <Compile Include="..\GyBlood.Mobile\Core\GlobalUsings.cs" Link="Linked\GlobalUsings.cs" />
    <Compile Include="..\GyBlood.Mobile\Core\Enums\*.cs" LinkBase="Linked\Core\Enums" />
    <Compile Include="..\GyBlood.Mobile\Core\Helpers\BloodCompatibility.cs" Link="Linked\Core\Helpers\BloodCompatibility.cs" />
    <Compile Include="..\GyBlood.Mobile\Core\Helpers\InputValidator.cs" Link="Linked\Core\Helpers\InputValidator.cs" />
    <Compile Include="..\GyBlood.Mobile\Core\Helpers\DateHelper.cs" Link="Linked\Core\Helpers\DateHelper.cs" />
    <Compile Include="..\GyBlood.Mobile\Core\Constants\ApiRoutes.cs" Link="Linked\Core\Constants\ApiRoutes.cs" />
    <Compile Include="..\GyBlood.Mobile\Models\**\*.cs" LinkBase="Linked\Models" />
    <Compile Include="..\GyBlood.Mobile\Services\Api\I*Api.cs" LinkBase="Linked\Services\Api" />
  </ItemGroup>

</Project>
